{
  "ColtonStack": {
    "DatabasePath": "coltonstack.db",
    "Simulation": {
      "Enabled": true,
      "MinIntervalSeconds": 5,
      "MaxIntervalSeconds": 15,
      "SimulateTyping": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}