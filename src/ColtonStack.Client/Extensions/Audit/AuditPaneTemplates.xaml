<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ColtonStack.Client.ViewModels">

    <!--
      Extension-supplied UI for the audit pane. Because this dictionary is merged at runtime
      by the extension host, shared app styles are referenced with DynamicResource —
      parse-time StaticResource can only see this dictionary's own chain.
    -->

    <DataTemplate DataType="{x:Type vm:AuditViewModel}">
        <DockPanel Background="Transparent">
            <Grid DockPanel.Dock="Top" Margin="14,10,10,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Audit trail" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} entries}" Margin="10,0,0,0"
                               FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{DynamicResource Style.IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                        Command="{Binding LoadCommand}" ToolTip="Refresh audit trail" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Margin="12,4,12,10" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Every save, channel creation and profile change is audited by a plain service that receives dumb records — the same trail the legacy base class wrote invisibly." />

            <!-- Empty state -->
            <TextBlock Text="No audit entries yet." HorizontalAlignment="Center" Margin="0,40,0,0"
                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ListBox ItemsSource="{Binding Entries}" HorizontalContentAlignment="Stretch"
                     BorderThickness="0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Actor}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextStrong}" />
                                    <TextBlock Text="{Binding Action}" Margin="6,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.Green}" />
                                    <TextBlock Margin="6,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}">
                                        <Run Text="{Binding EntityType, Mode=OneWay}" /><Run Text=" #" /><Run Text="{Binding EntityId, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding PayloadJson}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, StringFormat=g}" FontSize="11"
                                       VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>