<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:audit="clr-namespace:ColtonStack.Client.Extensions.Audit">

    <!--
      Extension-supplied UI for the audit pane and its settings section. Because this dictionary
      is merged at runtime by the extension host, shared app styles are referenced with
      DynamicResource — parse-time StaticResource can only see this dictionary's own chain.
    -->

    <DataTemplate DataType="{x:Type audit:AuditViewModel}">
        <DockPanel Background="Transparent">
            <Grid DockPanel.Dock="Top" Margin="16,16,12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Audit trail" Style="{DynamicResource Style.SectionHeader}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} entries}" Margin="10,0,0,0"
                               Style="{DynamicResource Style.Muted}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{DynamicResource Style.IconButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                        Command="{Binding LoadCommand}" ToolTip="Refresh audit trail" />
            </Grid>

            <TextBlock DockPanel.Dock="Bottom" Margin="16,4,16,12" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="Every save, channel creation and profile change is audited by a plain service that receives dumb records — the same trail the legacy base class wrote invisibly." />

            <!-- Empty state -->
            <TextBlock Text="No audit entries yet." HorizontalAlignment="Center" Margin="0,40,0,0"
                       FontSize="12" Foreground="{DynamicResource Brush.TextMuted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ListBox ItemsSource="{Binding Entries}" HorizontalContentAlignment="Stretch"
                     Style="{DynamicResource Style.ChatList}" ItemContainerStyle="{DynamicResource Style.PlainItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Actor}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextStrong}" />
                                    <TextBlock Text="{Binding Action}" Margin="6,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.Green}" />
                                    <TextBlock Margin="6,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Brush.TextMuted}">
                                        <Run Text="{Binding EntityType, Mode=OneWay}" /><Run Text=" #" /><Run Text="{Binding EntityId, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding PayloadJson}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>

                            <TextBlock Grid.Column="1" Text="{Binding TimestampUtc, StringFormat=g}" FontSize="11"
                                       VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextMuted}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DataTemplate>

    <!-- Settings section contributed by the extension -->
    <DataTemplate DataType="{x:Type audit:AuditSettingsViewModel}">
        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Audit trail" Style="{DynamicResource Style.PageTitle}" />
            <TextBlock Text="Contributed by the audit extension. The value is stored on the server under the key the extension owns (audit.pagesize); the core never learns what it means."
                       Style="{DynamicResource Style.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,20" />

            <TextBlock Text="Entries per load" Style="{DynamicResource Style.SectionHeader}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize, Mode=TwoWay}"
                     Style="{DynamicResource Style.ChoiceList}" />
            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Style.Muted}" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
