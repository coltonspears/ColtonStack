<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pokemon="clr-namespace:ColtonStack.Client.Extensions.Pokemon">

    <!--
      Extension-supplied UI: the card attachment and the settings section. Merged at runtime by
      the extension host, so shared app styles are referenced with DynamicResource.
    -->

    <pokemon:PokemonTypeBrushConverter x:Key="Pokemon.TypeBrush" />
    <!-- Binding.Converter is not a dependency property, so it cannot take a DynamicResource: the extension owns its own instance. -->
    <BooleanToVisibilityConverter x:Key="Pokemon.BoolToVisibility" />

    <!-- Thin stat bar: a ProgressBar so WPF sizes the indicator (0..1) for us -->
    <Style x:Key="Pokemon.StatBar" TargetType="ProgressBar">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#26FFFFFF" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type pokemon:PokemonCardViewModel}">
        <Border Width="460" HorizontalAlignment="Left" Margin="0,6,0,2" CornerRadius="12"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header band tinted by the primary type (tint layer sits under the content so only it is translucent) -->
                <Grid Grid.Row="0">
                    <Border CornerRadius="12,12,0,0" Opacity="0.22" Background="{Binding PrimaryType, Converter={StaticResource Pokemon.TypeBrush}}" />
                    <Grid Margin="16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Brush.TextStrong}" />
                                <TextBlock Text="{Binding Number}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource Brush.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Genus}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,8" />
                            <ItemsControl ItemsSource="{Binding Types}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,3" Margin="0,0,6,0" Background="{Binding Converter={StaticResource Pokemon.TypeBrush}}">
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FlavorText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,12,0" FontStyle="Italic"
                                       Foreground="{DynamicResource Brush.Text}" />
                        </StackPanel>

                        <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Top">
                            <Ellipse Fill="#14FFFFFF" />
                            <Image Source="{Binding ImageUrl, IsAsync=True}" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                            <Button Style="{DynamicResource Style.IconButton}" Content="&#xE734;" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Command="{Binding ToggleShinyCommand}" ToolTip="Toggle shiny artwork" />
                            <TextBlock Text="✨" FontSize="13" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                                       Visibility="{Binding IsShiny, Converter={StaticResource Pokemon.BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Body: stats, abilities, moves -->
                <Grid Grid.Row="1" Margin="16,12,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalStats, StringFormat=total {0}}" Style="{DynamicResource Style.Muted}" />
                            <TextBlock Text="Base stats" Style="{DynamicResource Style.SectionHeader}" FontSize="12" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextStrong}" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="2" Style="{StaticResource Pokemon.StatBar}" Value="{Binding Fraction, Mode=OneWay}"
                                                     Foreground="{Binding DataContext.PrimaryType, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Pokemon.TypeBrush}}"
                                                     VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Abilities" Style="{DynamicResource Style.SectionHeader}" FontSize="12" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AbilitiesText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="Moves" Style="{DynamicResource Style.SectionHeader}" FontSize="12" Margin="0,10,0,4" />
                        <TextBlock Text="{Binding MovesText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" />
                        <TextBlock Text="{Binding SizeText}" Style="{DynamicResource Style.Muted}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Settings section contributed by the extension -->
    <DataTemplate DataType="{x:Type pokemon:PokemonSettingsViewModel}">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Pokémon cards" Style="{DynamicResource Style.PageTitle}" />
            <TextBlock Text="Contributed by the Pokémon extension. Both values persist on the server under keys the extension owns (pokemon.artwork, pokemon.shiny) through the core settings store."
                       Style="{DynamicResource Style.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,20" />

            <TextBlock Text="Artwork" Style="{DynamicResource Style.SectionHeader}" Margin="0,0,0,8" />
            <ListBox ItemsSource="{Binding ArtworkChoices}" SelectedItem="{Binding Artwork, Mode=TwoWay}" Style="{DynamicResource Style.ChoiceList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Shiny" Style="{DynamicResource Style.SectionHeader}" Margin="0,14,0,8" />
            <CheckBox Content="Show shiny artwork by default" IsChecked="{Binding PreferShiny, Mode=TwoWay}" Foreground="{DynamicResource Brush.Text}" />

            <TextBlock Text="{Binding StatusText}" Style="{DynamicResource Style.Muted}" Margin="0,14,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
