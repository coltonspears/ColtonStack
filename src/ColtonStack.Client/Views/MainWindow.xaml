<Window x:Class="ColtonStack.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:behaviors="clr-namespace:ColtonStack.Client.Behaviors"
        xmlns:views="clr-namespace:ColtonStack.Client.Views"
        xmlns:vm="clr-namespace:ColtonStack.Client.ViewModels"
        mc:Ignorable="d"
        Title="ColtonStack"
        Width="1340" Height="840"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        behaviors:TitleBarTheme.IsDark="True"
        FontFamily="Segoe UI" FontSize="13">

    <Window.InputBindings>
        <!-- Escape dismisses the preferences overlay (a no-op when it isn't open). -->
        <KeyBinding Key="Escape" Command="{Binding Settings.CloseCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Sidebar row: # glyph, name, unread badge, latest-message preview -->
        <DataTemplate x:Key="Template.ChannelItem">
            <Grid Margin="6,2,6,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" Margin="4,0,7,0"
                           VerticalAlignment="Top"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="PreviewText" Text="{Binding Preview}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource Brush.Accent}" Padding="7,1" VerticalAlignment="Center"
                        Visibility="{Binding HasUnread, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            Pane templates: each sidebar pane's view model renders through an implicit
            DataTemplate keyed on its type. Core panes live here; extensions supply their own
            template dictionaries merged at startup (see AuditPaneTemplates.xaml). The shell
            only hosts a ContentControl — it has no idea how many panes exist.
        -->

        <!-- Channels pane: channel list with inline create flow -->
        <DataTemplate DataType="{x:Type vm:ChannelListViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,12,4">
                    <TextBlock Text="Channels" Style="{StaticResource Style.SectionHeader}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.IconButton}"
                            Content="&#xE710;" Command="{Binding ToggleAddChannelCommand}" ToolTip="Create a channel" />
                </Grid>

                <Border DockPanel.Dock="Top" Margin="14,2,14,6"
                        Visibility="{Binding IsAddingChannel, Converter={StaticResource Converter.BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource Style.IconButton}" Foreground="{StaticResource Brush.Green}"
                                Content="&#xE724;" Command="{Binding CreateChannelCommand}" FontSize="13"
                                ToolTip="Create channel" />
                        <TextBox Style="{StaticResource Style.Input}" FontSize="12"
                                 Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.ToolTip>Name the channel, press the arrow (live via SignalR on every client)</TextBox.ToolTip>
                        </TextBox>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding Channels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         ItemTemplate="{StaticResource Template.ChannelItem}"
                         Style="{StaticResource Style.ChannelList}"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </DataTemplate>

        <!-- People pane: the workspace directory -->
        <DataTemplate DataType="{x:Type vm:PeopleViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,12,4">
                    <TextBlock Text="People" Style="{StaticResource Style.SectionHeader}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.IconButton}"
                            Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Refresh" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding People}" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{Binding AvatarColor}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.Text}" />
                                        <TextBlock Text="you" Margin="6,2,0,0" Style="{StaticResource Style.Muted}"
                                                   Visibility="{Binding IsSelf, Converter={StaticResource Converter.BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Message row: rounded avatar, grouped author header, body, hover action bar -->
        <DataTemplate x:Key="Template.Message">
            <Grid x:Name="RowRoot" Margin="14,2,14,1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="8" Background="{Binding AvatarColor}" VerticalAlignment="Top"
                        Visibility="{Binding IsFirstOfGroup, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,8">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsFirstOfGroup, Converter={StaticResource Converter.BoolToVisibility}}">
                        <TextBlock Text="{Binding AuthorName}" Foreground="{StaticResource Brush.TextStrong}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Style.Muted}" Margin="8,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- Renders *bold*, _italic_, ~strike~, `code` and clickable links -->
                    <TextBlock behaviors:MessageTextFormatter.FormattedText="{Binding Text}"
                               TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Margin="0,1,24,0" />
                </StackPanel>
                <Border x:Name="HoverActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,-6,0"
                        Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="6,2" Panel.ZIndex="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="5,2" Cursor="Hand" ToolTip="Add reaction" />
                        <TextBlock Text="&#xE97A;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="5,2" Cursor="Hand" ToolTip="Reply in thread" />
                        <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                                   Margin="5,2" Cursor="Hand" ToolTip="More actions" />
                    </StackPanel>
                </Border>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush.RowHover}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================ Workspace rail ============================ -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Rail}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource Style.RailButton}" Content="&#xE713;" HorizontalAlignment="Center"
                            Margin="0,4,0,12" ToolTip="Preferences" Command="{Binding Settings.OpenCommand}" />
                    <Border DockPanel.Dock="Top" Width="42" Height="42" CornerRadius="11" Background="{StaticResource Brush.Aubergine}"
                            HorizontalAlignment="Center" Margin="0,14,0,8">
                        <TextBlock Text="CS" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Brush.Border}" Margin="16,2,16,10" />
                    <!-- Panes come from the extension registry: the rail renders whatever was
                         registered (core panes, audit, future extensions) and two-way selection
                         binding drives ActivePane — no enum, no per-pane wiring. -->
                    <ListBox ItemsSource="{Binding Panes}"
                             SelectedItem="{Binding ActivePane, Mode=TwoWay}"
                             Style="{StaticResource Style.RailList}"
                             ItemContainerStyle="{StaticResource Style.RailItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IconGlyph}" ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============================ Sidebar ============================ -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <!-- The active pane's view model renders here through its implicit DataTemplate.
                     The shell knows nothing about pane contents; extensions bring their own. -->
                <ContentControl Content="{Binding ActiveContent}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Focusable="False" />
            </Border>

            <!-- ============================ Conversation ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Chat.TypingIndicator}" Foreground="{StaticResource Brush.Green}" FontStyle="Italic" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.TypingIndicator}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE721;" Command="{Binding Chat.ToggleSearchCommand}"
                                    ToolTip="Search messages (Ctrl+F)" Margin="0,0,6,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Chat.ChannelTitle}" Foreground="{StaticResource Brush.TextStrong}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding Chat.CurrentChannel.Topic}" Style="{StaticResource Style.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search bar (appears when search is toggled) -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,8"
                        Visibility="{Binding Chat.IsSearchActive, Converter={StaticResource Converter.BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Style.Input}" FontSize="12"
                                 Text="{Binding Chat.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:ComposerActions.Target="{Binding ElementName=SearchBox}">
                            <TextBox.ToolTip>Search messages — pauses as you type, applies instantly</TextBox.ToolTip>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Chat.SearchResultCount, StringFormat={}{0} result(s)}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" Visibility="{Binding Chat.IsSearchActive, Converter={StaticResource Converter.BoolToVisibility}}" />
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE711;" Command="{Binding Chat.ClearSearchCommand}"
                                    ToolTip="Clear search" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Chat.FilteredMessages}"
                         ItemTemplate="{StaticResource Template.Message}"
                         Style="{StaticResource Style.ChatList}"
                         behaviors:AutoScrollBehavior.ScrollToNewItem="True"
                         HorizontalContentAlignment="Stretch" />

                <!-- Composer. Every toolbar button below (including the emoji tiles inside the
                     popup) inherits ComposerActions.Target from this Border — one binding,
                     wrap/insert behavior everywhere, zero code-behind. -->
                <Border Grid.Row="2" Margin="14,4,18,14" CornerRadius="10" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="12,8"
                        behaviors:ComposerActions.Target="{Binding ElementName=ComposerBox}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Selection}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid MinHeight="40">
                            <TextBlock Text="{Binding Chat.ComposerPlaceholder}" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="ComposerBox" Style="{StaticResource Style.BorderlessInput}" FontSize="13.5"
                                     MinHeight="40" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Text="{Binding Chat.Draft, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>Enter sends · Shift+Enter makes a new line</TextBox.ToolTip>
                                <TextBox.InputBindings>
                                    <!-- Plain Enter sends (input bindings run before the TextBox inserts the
                                         newline); Shift+Enter doesn't match the gesture, so it falls through
                                         to AcceptsReturn and makes a new line. No code-behind required. -->
                                    <KeyBinding Key="Enter" Command="{Binding Chat.SendMessageCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" Margin="0,4,0,7" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Style.FormatButton}" FontWeight="Bold" Content="B"
                                        behaviors:ComposerActions.Wrap="*" ToolTip="Bold — wraps the selection in *asterisks*" />
                                <Button Style="{StaticResource Style.FormatButton}" FontStyle="Italic" Content="I" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="_" ToolTip="Italic — wraps the selection in _underscores_" />
                                <Button Style="{StaticResource Style.FormatButton}" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="~" ToolTip="Strikethrough — wraps the selection in ~tildes~">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </Button>
                                <Button Style="{StaticResource Style.FormatButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE943;" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="`" ToolTip="Code — wraps the selection in `backticks`" />
                                <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Border}" Margin="8,0" VerticalAlignment="Center" />
                                <ToggleButton x:Name="EmojiToggle" Style="{StaticResource Style.IconToggle}" Content="&#xE76E;" ToolTip="Emoji" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=EmojiToggle, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=EmojiToggle}" Placement="Top"
                                       AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
                                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="10" Padding="8">
                                        <ItemsControl ItemsSource="{x:Static views:EmojiCatalog.All}" Width="272">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Style.EmojiButton}" Content="{Binding}"
                                                            behaviors:ComposerActions.Insert="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Style.PrimaryButton}" Padding="10,5"
                                    Command="{Binding Chat.SendMessageCommand}" ToolTip="Send (Enter)">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Style.PillToggle}" Content="logs"
                                  IsChecked="{Binding Diagnostics.IsOpen, Mode=TwoWay}"
                                  ToolTip="Live application log (ILogger): retries, reconnects, failures" />
                    <ToggleButton Margin="8,0,0,0" Style="{StaticResource Style.PillToggle}" Content="sim"
                                  IsChecked="{Binding Status.SimEnabled, Mode=TwoWay}"
                                  ToolTip="Server-side chat simulator: fake teammates type and post every few seconds" />
                    <ToggleButton Margin="8,0,0,0" Style="{StaticResource Style.PillToggle}" Content="chaos"
                                  IsChecked="{Binding Status.ChaosEnabled, Mode=TwoWay}"
                                  ToolTip="Make the server fail ~40% of API requests and watch the resilience pipeline work" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Style.StatusChip}" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Status.RetryCountText}" Foreground="{StaticResource Brush.Amber}" FontSize="11" />
                </Border>
                <Border Style="{StaticResource Style.StatusChip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{Binding Status.Status, Mode=OneWay}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Amber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.Status}" Value="Connected">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.Status}" Value="Disconnected">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status.StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================ Diagnostics slide-over ============================ -->
        <!-- Live ILogger output: the DiagnosticsLoggerProvider publishes entries onto the
             messenger and this panel subscribes like any other view model. The toggle lives
             on the status bar ("logs"). Bounded buffer (400 entries) — a tail, not a database. -->
        <Grid Grid.RowSpan="2" Visibility="{Binding Diagnostics.IsOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="440" HorizontalAlignment="Right"
                    Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Diagnostics" Style="{StaticResource Style.WorkspaceTitle}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Diagnostics.Entries.Count, StringFormat={}{0} entries}" Margin="10,0,0,0"
                                       Style="{StaticResource Style.Muted}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE74D;"
                                    Command="{Binding Diagnostics.ClearCommand}" ToolTip="Clear log" />
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE711;"
                                    Command="{Binding Diagnostics.CloseCommand}" ToolTip="Close panel" />
                        </StackPanel>
                    </Grid>

                    <ListBox ItemsSource="{Binding Diagnostics.Entries}"
                             Style="{StaticResource Style.ChatList}"
                             HorizontalContentAlignment="Stretch"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,3,8,0" VerticalAlignment="Top">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Green}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Amber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Category}" FontSize="10" Margin="8,0,0,0" FontStyle="Italic"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Text}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================ Preferences overlay ============================ -->
        <!-- Loaded from and saved to the server (Dapper.Contrib UPDATE); Escape or Cancel closes. -->
        <Grid Grid.RowSpan="2" Visibility="{Binding Settings.IsOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Background="#B3000000" />
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="12" Padding="22,18">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Preferences" Style="{StaticResource Style.WorkspaceTitle}" FontSize="16" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource Style.IconButton}" Content="&#xE711;"
                                Command="{Binding Settings.CloseCommand}" ToolTip="Close (Esc)" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Border Width="44" Height="44" CornerRadius="10" Background="{Binding Settings.AvatarColor}">
                            <TextBlock Text="{Binding Settings.Initials}" Foreground="White" FontWeight="SemiBold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="How you appear across the workspace." Foreground="{StaticResource Brush.Text}" FontSize="12" />
                            <TextBlock Text="Saved on the server — it survives restarts." Style="{StaticResource Style.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Display name" Style="{StaticResource Style.SectionHeader}" Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource Style.Input}" MaxLength="40"
                             Text="{Binding Settings.DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="Avatar color" Style="{StaticResource Style.SectionHeader}" Margin="0,14,0,6" />
                    <ListBox Style="{StaticResource Style.SwatchList}"
                             ItemsSource="{Binding Settings.Palette}"
                             SelectedItem="{Binding Settings.AvatarColor, Mode=TwoWay}" />

                    <TextBlock Text="{Binding Settings.ErrorText}" Foreground="{StaticResource Brush.Red}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ErrorText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Content="Cancel" Style="{StaticResource Style.GhostButton}" Command="{Binding Settings.CloseCommand}" />
                        <Button Content="Save" Style="{StaticResource Style.PrimaryButton}" MinWidth="72" Margin="8,0,0,0"
                                Command="{Binding Settings.SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
