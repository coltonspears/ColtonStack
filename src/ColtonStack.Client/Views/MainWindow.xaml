<Window x:Class="ColtonStack.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:behaviors="clr-namespace:ColtonStack.Client.Behaviors"
        xmlns:views="clr-namespace:ColtonStack.Client.Views"
        xmlns:vm="clr-namespace:ColtonStack.Client.ViewModels"
        xmlns:attachments="clr-namespace:ColtonStack.Client.Extensions.Attachments"
        mc:Ignorable="d"
        Title="ColtonStack"
        Icon="pack://application:,,,/ColtonStack.Client;component/Assets/ColtonStack.ico"
        Width="1340" Height="840"
        MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        behaviors:TitleBarTheme.IsDark="True"
        behaviors:WindowCaptionCommands.IsEnabled="True"
        FontFamily="Segoe UI" FontSize="13">

    <!-- Custom chrome: the title bar is ours (search palette lives in it); resize borders and
         caption-button semantics stay native via WindowChrome + SystemCommands. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="K" Command="{Binding Palette.OpenCommand}" />
        <KeyBinding Modifiers="Control" Key="F" Command="{Binding Chat.ToggleSearchCommand}" />
        <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding ToggleSettingsCommand}" />
        <!-- Escape closes whatever transient surface is on top (palette, settings, log panel). -->
        <KeyBinding Key="Escape" Command="{Binding DismissCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Sidebar row: # glyph, name, unread badge, latest-message preview -->
        <DataTemplate x:Key="Template.ChannelItem">
            <Grid Margin="6,2,6,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" Margin="4,0,7,0"
                           VerticalAlignment="Top"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="PreviewText" Text="{Binding Preview}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="9" Background="{StaticResource Brush.Accent}" Padding="7,1" VerticalAlignment="Center"
                        Visibility="{Binding HasUnread, Converter={StaticResource Converter.BoolToVisibility}}">
                    <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            Pane templates: each sidebar pane's view model renders through an implicit
            DataTemplate keyed on its type. Core panes live here; extensions supply their own
            template dictionaries merged at startup (see AuditPaneTemplates.xaml). The shell
            only hosts a ContentControl — it has no idea how many panes exist.
        -->

        <!-- Channels pane: channel list with inline create flow -->
        <DataTemplate DataType="{x:Type vm:ChannelListViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,12,4">
                    <TextBlock Text="Channels" Style="{StaticResource Style.SectionHeader}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.IconButton}"
                            Content="&#xE710;" Command="{Binding ToggleAddChannelCommand}" ToolTip="Create a channel" />
                </Grid>

                <Border DockPanel.Dock="Top" Margin="14,2,14,6"
                        Visibility="{Binding IsAddingChannel, Converter={StaticResource Converter.BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource Style.IconButton}" Foreground="{StaticResource Brush.Green}"
                                Content="&#xE724;" Command="{Binding CreateChannelCommand}" FontSize="13"
                                ToolTip="Create channel" />
                        <TextBox Style="{StaticResource Style.Input}" FontSize="12"
                                 behaviors:FocusBehavior.WhenTrue="{Binding IsAddingChannel}"
                                 Text="{Binding NewChannelName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CreateChannelCommand}" />
                            </TextBox.InputBindings>
                            <TextBox.ToolTip>Name the channel, press Enter (live via SignalR on every client)</TextBox.ToolTip>
                        </TextBox>
                    </DockPanel>
                </Border>

                <ListBox ItemsSource="{Binding Channels}"
                         SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                         ItemTemplate="{StaticResource Template.ChannelItem}"
                         Style="{StaticResource Style.ChannelList}"
                         HorizontalContentAlignment="Stretch" />
            </DockPanel>
        </DataTemplate>

        <!-- People pane: the workspace directory -->
        <DataTemplate DataType="{x:Type vm:PeopleViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,16,12,4">
                    <TextBlock Text="People" Style="{StaticResource Style.SectionHeader}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Style.IconButton}"
                            Content="&#xE72C;" Command="{Binding LoadCommand}" ToolTip="Refresh" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding People}" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{Binding AvatarColor}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.Text}" />
                                        <TextBlock Text="you" Margin="6,2,0,0" Style="{StaticResource Style.Muted}"
                                                   Visibility="{Binding IsSelf, Converter={StaticResource Converter.BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>

        <!-- Profile settings section (core). Extension sections ship their own templates. -->
        <DataTemplate DataType="{x:Type vm:ProfileSettingsViewModel}">
            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <TextBlock Text="Profile" Style="{StaticResource Style.PageTitle}" />
                <TextBlock Text="How you appear across the workspace. Saved on the server through the same validator the API enforces."
                           Style="{StaticResource Style.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,20" />

                <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="12" Background="{Binding AvatarColor}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource Brush.TextStrong}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Live preview" Style="{StaticResource Style.Muted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Display name" Style="{StaticResource Style.SectionHeader}" Margin="0,22,0,6" />
                <TextBox Style="{StaticResource Style.Input}" MaxLength="40" Width="320" HorizontalAlignment="Left"
                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Avatar color" Style="{StaticResource Style.SectionHeader}" Margin="0,18,0,6" />
                <ListBox Style="{StaticResource Style.SwatchList}"
                         ItemsSource="{Binding Palette}"
                         SelectedItem="{Binding AvatarColor, Mode=TwoWay}" />

                <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource Brush.Red}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="Save changes" Style="{StaticResource Style.PrimaryButton}" MinWidth="110" Command="{Binding SaveCommand}" />
                    <TextBlock Text="{Binding SavedText}" Foreground="{StaticResource Brush.Green}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Fallback for attachment kinds no installed extension renders -->
        <DataTemplate DataType="{x:Type attachments:UnknownAttachmentViewModel}">
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" HorizontalAlignment="Left" Margin="0,6,0,0">
                <TextBlock Style="{StaticResource Style.Muted}" FontSize="12">
                    <Run Text="This message has a" /><Run Text=" " /><Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" attachment this client can't render — install the extension." />
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- Message row: date divider, rounded avatar, grouped author header, body, attachment, hover copy -->
        <DataTemplate x:Key="Template.Message">
            <StackPanel>
                <!-- Slack-style date divider above the first message of each day -->
                <Grid Margin="14,12,14,6" Visibility="{Binding IsFirstOfDay, Converter={StaticResource Converter.BoolToVisibility}}">
                    <Rectangle Height="1" Fill="{StaticResource Brush.Border}" VerticalAlignment="Center" />
                    <Border HorizontalAlignment="Center" Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="12" Padding="12,3">
                        <TextBlock Text="{Binding DateHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextStrong}" />
                    </Border>
                </Grid>

                <Grid x:Name="RowRoot" Margin="14,1,14,1" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="8" Background="{Binding AvatarColor}" VerticalAlignment="Top" Margin="0,3,0,0"
                            Visibility="{Binding IsFirstOfGroup, Converter={StaticResource Converter.BoolToVisibility}}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,2,0,6">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsFirstOfGroup, Converter={StaticResource Converter.BoolToVisibility}}">
                            <TextBlock Text="{Binding AuthorName}" Foreground="{StaticResource Brush.TextStrong}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Style.Muted}" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Renders *bold*, _italic_, ~strike~, `code` and clickable links -->
                        <TextBlock behaviors:MessageTextFormatter.FormattedText="{Binding Text}"
                                   TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Margin="0,1,40,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Extension-rendered rich content: implicit DataTemplate per attachment view model type -->
                        <ContentControl Content="{Binding Attachment}" Focusable="False"
                                        Visibility="{Binding HasAttachment, Converter={StaticResource Converter.BoolToVisibility}}" />
                    </StackPanel>
                    <Border x:Name="HoverActions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-6,0"
                            Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="2" Panel.ZIndex="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Style="{StaticResource Style.IconButton}" Content="&#xE8C8;" ToolTip="Copy message text"
                                behaviors:ClipboardActions.CopyText="{Binding Text}" />
                    </Border>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.RowHover}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Command palette row -->
        <DataTemplate x:Key="Template.PaletteItem">
            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.Palette.RunItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Style.KeyChip}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Slash-command suggestion row -->
        <DataTemplate x:Key="Template.SlashSuggestion">
            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.Chat.PickSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Margin="14,1,0,0" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- WindowChrome + maximize overflows by the resize border; the trigger compensates. -->
    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ Title bar ============================ -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Rail}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image Source="pack://application:,,,/ColtonStack.Client;component/Assets/ColtonStack.ico" Width="18" Height="18" />
                    <TextBlock Text="ColtonStack" Foreground="{StaticResource Brush.TextStrong}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <!-- The palette launcher: Ctrl+K or click. The popup below is the palette itself. -->
                <Button x:Name="PaletteLauncher" Grid.Column="1" Style="{StaticResource Style.PaletteLauncher}" Width="520"
                        Command="{Binding Palette.OpenCommand}" ToolTip="Search commands, channels and settings (Ctrl+K)">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextMuted}" />
                            <TextBlock Text="Search ColtonStack — commands, channels, settings" Margin="8,0,0,0" FontSize="12" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource Style.KeyChip}" HorizontalAlignment="Right">
                            <TextBlock Text="Ctrl+K" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                        </Border>
                    </Grid>
                </Button>

                <Popup IsOpen="{Binding Palette.IsOpen, Mode=TwoWay}" StaysOpen="False"
                       PlacementTarget="{Binding ElementName=PaletteLauncher}" Placement="Bottom"
                       AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" Width="560">
                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,10,0" />
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Style.KeyChip}">
                                        <TextBlock Text="Esc" FontSize="10" Foreground="{StaticResource Brush.TextMuted}" />
                                    </Border>
                                    <TextBox Style="{StaticResource Style.BorderlessInput}" FontSize="14" VerticalContentAlignment="Center"
                                             behaviors:FocusBehavior.WhenTrue="{Binding Palette.IsOpen}"
                                             Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Down" Command="{Binding Palette.MoveDownCommand}" />
                                            <KeyBinding Key="Up" Command="{Binding Palette.MoveUpCommand}" />
                                            <KeyBinding Key="Enter" Command="{Binding Palette.RunSelectedCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding Palette.CloseCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </DockPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Margin="14,6,14,10" Style="{StaticResource Style.Muted}"
                                       Text="Every row here was registered by an extension — the palette holds no list of its own." />
                            <TextBlock Text="No matching commands." Margin="14,14" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Style.Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Palette.HasResults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ListBox ItemsSource="{Binding Palette.Results}" SelectedItem="{Binding Palette.Selected, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource Template.PaletteItem}" Style="{StaticResource Style.ResultList}"
                                     MaxHeight="420" HorizontalContentAlignment="Stretch" />
                        </DockPanel>
                    </Border>
                </Popup>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource Style.CaptionButton}" Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="Minimize" />
                    <Button Content="&#xE922;" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="Maximize">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.CaptionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="&#xE923;" Command="{x:Static SystemCommands.RestoreWindowCommand}" ToolTip="Restore">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.CaptionButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Style.CaptionCloseButton}" Content="&#xE8BB;" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================ Body ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="264" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Workspace rail -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Rail}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Bottom" Style="{StaticResource Style.RailToggleButton}" Content="&#xE713;" HorizontalAlignment="Center"
                                  Margin="0,4,0,12" ToolTip="Settings (Ctrl+,)" IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}" />
                    <Border DockPanel.Dock="Top" Width="42" Height="42" CornerRadius="11" Background="{StaticResource Brush.Aubergine}"
                            HorizontalAlignment="Center" Margin="0,14,0,8">
                        <TextBlock Text="CS" Foreground="White" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource Brush.Border}" Margin="16,2,16,10" />
                    <!-- Panes come from the extension registry: the rail renders whatever was
                         registered (core panes, audit, future extensions) and two-way selection
                         binding drives ActivePane — no enum, no per-pane wiring. -->
                    <ListBox ItemsSource="{Binding Panes}"
                             SelectedItem="{Binding ActivePane, Mode=TwoWay}"
                             Style="{StaticResource Style.RailList}"
                             ItemContainerStyle="{StaticResource Style.RailItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IconGlyph}" ToolTip="{Binding Title}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Sidebar: the active pane's view model renders here through its implicit DataTemplate. -->
            <Border Grid.Column="1" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding ActiveContent}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Focusable="False" />
            </Border>

            <!-- ============================ Conversation ============================ -->
            <Grid Grid.Column="2">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="18,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Chat.TypingIndicator}" Foreground="{StaticResource Brush.Green}" FontStyle="Italic" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.TypingIndicator}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE721;" Command="{Binding Chat.ToggleSearchCommand}"
                                    ToolTip="Search messages (Ctrl+F)" Margin="0,0,6,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Chat.ChannelTitle}" Foreground="{StaticResource Brush.TextStrong}" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="{Binding Chat.CurrentChannel.Topic}" Style="{StaticResource Style.Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Search bar (appears when search is toggled) -->
                <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="10,8"
                        Visibility="{Binding Chat.IsSearchActive, Converter={StaticResource Converter.BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Style.Input}" FontSize="12"
                                 behaviors:FocusBehavior.WhenTrue="{Binding Chat.IsSearchActive}"
                                 Text="{Binding Chat.SearchText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.ToolTip>Search messages — pauses as you type, applies instantly</TextBox.ToolTip>
                        </TextBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Chat.Search.Count, StringFormat={}{0} result(s)}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"
                                       Foreground="{StaticResource Brush.TextMuted}" />
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE711;" Command="{Binding Chat.ToggleSearchCommand}"
                                    ToolTip="Close search (Esc)" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Chat.Search.Results}"
                         ItemTemplate="{StaticResource Template.Message}"
                         ItemContainerStyle="{StaticResource Style.PlainItem}"
                         Style="{StaticResource Style.ChatList}"
                         behaviors:AutoScrollBehavior.ScrollToNewItem="True"
                         HorizontalContentAlignment="Stretch" />

                <!-- Empty state -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Chat.Search.Count}" Value="0" />
                                        <Condition Binding="{Binding Chat.IsLoadingHistory}" Value="False" />
                                        <Condition Binding="{Binding Chat.HasChannel}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource Brush.Border}" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,12,0,0" FontSize="14" Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Nothing here yet — say hello, or type / for commands." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Chat.Search.IsFiltering}" Value="True">
                                        <Setter Property="Text" Value="No messages match your search." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Composer. Every toolbar button below (including the emoji tiles inside the
                     popup) inherits ComposerActions.Target from this Border — one binding,
                     wrap/insert behavior everywhere, zero code-behind. -->
                <Border x:Name="Composer" Grid.Row="3" Margin="14,4,18,14" CornerRadius="10" Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Padding="12,8"
                        behaviors:ComposerActions.Target="{Binding ElementName=ComposerBox}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Selection}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Slash-command suggestions: driven entirely by Chat.Slash state -->
                        <Popup IsOpen="{Binding Chat.Slash.HasSuggestions, Mode=OneWay}" StaysOpen="True"
                               PlacementTarget="{Binding ElementName=Composer}" Placement="Top"
                               AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6"
                               Width="{Binding ActualWidth, ElementName=Composer}">
                            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="10">
                                <DockPanel>
                                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,6">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="↑↓ choose · Tab complete · Enter run" Style="{StaticResource Style.Muted}" />
                                            <TextBlock Text="{Binding Chat.Slash.StatusText}" Style="{StaticResource Style.Muted}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Border>
                                    <ListBox ItemsSource="{Binding Chat.Slash.Suggestions}" SelectedItem="{Binding Chat.Slash.Selected, Mode=TwoWay}"
                                             ItemTemplate="{StaticResource Template.SlashSuggestion}" Style="{StaticResource Style.ResultList}"
                                             MaxHeight="260" HorizontalContentAlignment="Stretch" />
                                </DockPanel>
                            </Border>
                        </Popup>

                        <Grid MinHeight="40">
                            <TextBlock Text="{Binding Chat.ComposerPlaceholder}" Foreground="{StaticResource Brush.TextMuted}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Chat.Draft}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="ComposerBox" Style="{StaticResource Style.BorderlessInput}" FontSize="13.5"
                                     MinHeight="40" AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Text="{Binding Chat.Draft, UpdateSourceTrigger=PropertyChanged}">
                                <TextBox.ToolTip>Enter sends · Shift+Enter makes a new line · / for commands</TextBox.ToolTip>
                                <TextBox.InputBindings>
                                    <!-- Plain Enter sends (input bindings run before the TextBox inserts the
                                         newline); Shift+Enter doesn't match the gesture, so it falls through
                                         to AcceptsReturn and makes a new line. The slash bindings only
                                         CanExecute while the suggestion popup is open, so Up/Down/Tab keep
                                         their normal meaning otherwise. No code-behind required. -->
                                    <KeyBinding Key="Enter" Command="{Binding Chat.SendMessageCommand}" />
                                    <KeyBinding Key="Down" Command="{Binding Chat.NextSuggestionCommand}" />
                                    <KeyBinding Key="Up" Command="{Binding Chat.PreviousSuggestionCommand}" />
                                    <KeyBinding Key="Tab" Command="{Binding Chat.AcceptSuggestionCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                        <Rectangle Height="1" Fill="{StaticResource Brush.Border}" Margin="0,4,0,7" />
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Style.FormatButton}" FontWeight="Bold" Content="B"
                                        behaviors:ComposerActions.Wrap="*" ToolTip="Bold — wraps the selection in *asterisks*" />
                                <Button Style="{StaticResource Style.FormatButton}" FontStyle="Italic" Content="I" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="_" ToolTip="Italic — wraps the selection in _underscores_" />
                                <Button Style="{StaticResource Style.FormatButton}" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="~" ToolTip="Strikethrough — wraps the selection in ~tildes~">
                                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                                </Button>
                                <Button Style="{StaticResource Style.FormatButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE943;" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Wrap="`" ToolTip="Code — wraps the selection in `backticks`" />
                                <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Border}" Margin="8,0" VerticalAlignment="Center" />
                                <ToggleButton x:Name="EmojiToggle" Style="{StaticResource Style.IconToggle}" Content="&#xE76E;" ToolTip="Emoji" />
                                <Popup IsOpen="{Binding IsChecked, ElementName=EmojiToggle, Mode=TwoWay}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=EmojiToggle}" Placement="Top"
                                       AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-6">
                                    <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="10" Padding="8">
                                        <ItemsControl ItemsSource="{x:Static views:EmojiCatalog.All}" Width="272">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Style.EmojiButton}" Content="{Binding}"
                                                            behaviors:ComposerActions.Insert="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </Popup>
                                <Button Style="{StaticResource Style.FormatButton}" FontFamily="Segoe UI" FontWeight="Bold" Content="/" Margin="2,0,0,0"
                                        behaviors:ComposerActions.Insert="/" ToolTip="Slash commands — /pokemon, /shrug, …" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource Style.PrimaryButton}" Padding="10,5"
                                    Command="{Binding Chat.SendMessageCommand}" ToolTip="Send (Enter)">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================ Settings page (in-window) ============================ -->
            <Grid Grid.Column="2" Visibility="{Binding IsSettingsOpen, Converter={StaticResource Converter.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Settings" Style="{StaticResource Style.WorkspaceTitle}" FontSize="16" Margin="16,16,16,10" />
                        <!-- Sections come from the settings registry; core and extensions alike. -->
                        <ListBox ItemsSource="{Binding Settings.Sections}" SelectedItem="{Binding Settings.ActiveSection, Mode=TwoWay}"
                                 Style="{StaticResource Style.SettingsNav}" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Column="1">
                    <Grid DockPanel.Dock="Top" Margin="0,8,12,0">
                        <Button Style="{StaticResource Style.IconButton}" Content="&#xE711;" HorizontalAlignment="Right"
                                Command="{Binding CloseSettingsCommand}" ToolTip="Back to chat (Esc)" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,8,32,32">
                        <ContentControl Content="{Binding Settings.ActiveContent}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- ============================ Status bar ============================ -->
        <Border Grid.Row="2" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,7">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton Style="{StaticResource Style.PillToggle}" Content="logs"
                                  IsChecked="{Binding Diagnostics.IsOpen, Mode=TwoWay}"
                                  ToolTip="Live application log (ILogger): retries, reconnects, failures" />
                    <ToggleButton Margin="8,0,0,0" Style="{StaticResource Style.PillToggle}" Content="sim"
                                  IsChecked="{Binding Status.SimEnabled, Mode=TwoWay}"
                                  ToolTip="Server-side chat simulator: fake teammates type and post every few seconds" />
                    <ToggleButton Margin="8,0,0,0" Style="{StaticResource Style.PillToggle}" Content="chaos"
                                  IsChecked="{Binding Status.ChaosEnabled, Mode=TwoWay}"
                                  ToolTip="Make the server fail ~40% of API requests and watch the resilience pipeline work" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Style.StatusChip}" Margin="0,0,14,0">
                    <TextBlock Text="{Binding Status.RetryCountText}" Foreground="{StaticResource Brush.Amber}" FontSize="11" />
                </Border>
                <Border Style="{StaticResource Style.StatusChip}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Brush.Amber}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status.Status}" Value="Connected">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Green}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status.Status}" Value="Disconnected">
                                            <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status.StatusText}" Foreground="{StaticResource Brush.TextMuted}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ============================ Diagnostics slide-over ============================ -->
        <!-- Live ILogger output: the DiagnosticsLoggerProvider publishes entries onto the
             messenger and this panel subscribes like any other view model. The toggle lives
             on the status bar ("logs"). Bounded buffer (400 entries) — a tail, not a database. -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding Diagnostics.IsOpen, Converter={StaticResource Converter.BoolToVisibility}}">
            <Border Width="440" HorizontalAlignment="Right"
                    Background="{StaticResource Brush.Background}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,12,10,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Diagnostics" Style="{StaticResource Style.WorkspaceTitle}" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Diagnostics.Entries.Count, StringFormat={}{0} entries}" Margin="10,0,0,0"
                                       Style="{StaticResource Style.Muted}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE74D;"
                                    Command="{Binding Diagnostics.ClearCommand}" ToolTip="Clear log" />
                            <Button Style="{StaticResource Style.IconButton}" Content="&#xE711;"
                                    Command="{Binding Diagnostics.CloseCommand}" ToolTip="Close panel" />
                        </StackPanel>
                    </Grid>

                    <ListBox ItemsSource="{Binding Diagnostics.Entries}"
                             Style="{StaticResource Style.ChatList}"
                             ItemContainerStyle="{StaticResource Style.PlainItem}"
                             HorizontalContentAlignment="Stretch"
                             behaviors:AutoScrollBehavior.ScrollToNewItem="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="0,3,8,0" VerticalAlignment="Top">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Brush.Green}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Amber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                        <Setter Property="Fill" Value="{StaticResource Brush.Red}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Category}" FontSize="10" Margin="8,0,0,0" FontStyle="Italic"
                                                       Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.Text}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
